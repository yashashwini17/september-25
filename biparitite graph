from collections import deque
class Solution:
    def isBipartite(self, V, edges):
        adj=[]
        for _ in range(V):
            adj.append([])
        for u,v in edges:
            adj[u].append[v]
            adj[v].append(u)
        color=[-1]*V
        color[0]=1
        q=deque([0])
        while(len(q)>0):
            node=q.popleft()
            for adjNode in adj[node]:
                if(color[adjNode]==-1):
                    color[adjNode]=1-color[node]
                    q.append(adjNode)
                elif(color[adjNode]!=-1):
                    if(color[node]==color[adjNode]):
                        return False
        return True
            
            
