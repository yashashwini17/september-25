'''
Definition for Node
class Node:
    def __init__(self, val):
        self.right = None
        self.data = val
        self.left = None 
'''
        
class Solution:
    def findCeil(self,root, x):
        ans=-1
        while(root is not None):
            if(root.data>=x):
                ans=root.data
                root=root.left
            else:
                root=root.right
        return ans
