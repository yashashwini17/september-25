class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        '''n=len(nums)
        for i in range(0,n):
            for j in range(i+1,n):
                if(nums[i]+nums[j]==target):
                    return[i,j]'''
        d={}
        n=len(nums)
        for a in range(0,n):
            num=nums[a]
            b=target-num
            if(b in d):
                return [a,d[b]]
            d[num]=a
        
