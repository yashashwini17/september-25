'''
Definition for Node
class Node:
    def __init__(self, val):
        self.data = val
        self.left = None
        self.right = None
'''

class Solution:
    def insert(self, root, key):
        if(root.data==key):
            return root
        temp=root
        while(temp is not None):
            if(key>temp.data):
                if(temp.right==None):
                    temp.right=Node(key)
                    break
                temp=temp.right
            elif(key<temp.data):
                if(temp.left==None):
                    temp.left=Node(key)
                    break
                temp=temp.left
        return root
